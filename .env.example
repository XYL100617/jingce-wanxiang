# 此文件仅作变量清单；当前 Node 服务不会自动读取 .env 文件。
# Windows PowerShell: $env:ADMIN_USERNAME='admin'; $env:ADMIN_PASSWORD='自己设置的强密码'; npm.cmd start
# 管理员仅在账号文件中尚无管理员时创建；密码不要提交到仓库。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_DISPLAY_NAME=景区管理员
# 可选：账号和审计文件默认写入 server/data/*.local.*
# ACCOUNTS_FILE=D:\jingxing\private\accounts.json
# AUDIT_FILE=D:\jingxing\private\audit.jsonl

# 陪伴问答：在服务进程环境中设置；此文件不会自动加载。
# COMPANION_PROVIDER=zhipu
# ZHIPU_API_KEY=replace-with-server-side-key
# COMPANION_MODEL=glm-4.7-flash
# COMPANION_ZHIPU_FREE_ONLY_CONFIRMED=true

# vivo AI算法平台 ASR/TTS。取得应用权限并确认免费额度后再开启。
# VIVO_AI_APP_ID=your-vivo-app-id
# VIVO_AI_APP_KEY=your-vivo-app-key
# VIVO_AI_FREE_CONFIRMED=true

# 百度千帆短文本语音合成；仅确认控制台有可用免费额度后才开启。
# Render 等部署环境设置以下变量；密钥不得提交到仓库。
# QIANFAN_TTS_API_KEY=your-baidu-qianfan-api-key
# QIANFAN_TTS_FREE_CONFIRMED=true
